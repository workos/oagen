{
  "openapi": "3.1.0",
  "info": { "title": "Pets", "version": "1" },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "parameters": [
          { "name": "X-RateLimit-Policy", "in": "header", "schema": { "type": "string", "enum": ["burst", "sustained"] } },
          {
            "name": "X-Pet-Meta",
            "in": "header",
            "schema": { "type": "object", "properties": { "etag": { "type": "string" } } }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-RateLimit-Scope": { "schema": { "type": "string", "enum": ["user", "org"] } },
              "X-Pet-Origin": { "schema": { "type": "object", "properties": { "region": { "type": "string" } } } }
            },
            "content": { "application/json": { "schema": { "type": "string" } } }
          }
        }
      }
    }
  },
  "webhooks": {
    "petAdopted": {
      "post": {
        "operationId": "petAdopted",
        "parameters": [
          { "name": "X-Pet-Signature-Algo", "in": "header", "schema": { "type": "string", "enum": ["sha256", "sha512"] } },
          {
            "name": "X-Pet-Meta",
            "in": "header",
            "schema": { "type": "object", "properties": { "etag": { "type": "string" } } }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "type": "object", "properties": { "pet_id": { "type": "string" } } } }
          }
        },
        "responses": { "200": { "description": "Acknowledged" } }
      }
    }
  }
}
