{
  "openapi": "3.1.0",
  "info": { "title": "repro", "version": "1" },
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "X-Key" },
      "bearer": { "type": "http", "scheme": "bearer" }
    }
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["Pets", "Store"],
        "security": [{ "bearer": [] }],
        "responses": { "204": { "description": "ok" } }
      }
    }
  },
  "webhooks": {
    "petAdopted": {
      "post": {
        "tags": ["Pets", "Store"],
        "security": [{ "bearer": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
